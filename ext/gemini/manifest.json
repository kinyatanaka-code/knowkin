{
  "manifest_version": 3,
  "name": "knowkin for Gemini",
  "version": "1.3.0",
  "description": "Geminiとの会話を（スマホの会話も）、押さなくても knowkin の AI履歴に残す",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://gemini.google.com/*", "https://knowkin-production.up.railway.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "options_page": "options.html",
  "action": { "default_title": "knowkin for Gemini", "default_popup": "options.html" },
  "icons": { "128": "icon128.png" }
}
