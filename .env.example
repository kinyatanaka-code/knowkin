# 必須
DATABASE_URL=postgresql://user:pass@host:5432/railway
# Web画面とAPIのログイン用（長いランダム文字列）
APP_TOKEN=change-me-long-random-string
# MCPのURLに入れる秘密の文字列（長いランダム文字列）。 openssl rand -hex 24 などで作成
MCP_SECRET=change-me-another-long-random-string

# 分類に使うAI。空（none）なら無料：Claude.aiとの会話の中で整理する
# サーバー側でも自動分類したいときだけ anthropic / openai / gemini / deepseek を指定
AI_PROVIDER=
# AI_PROVIDERを設定した場合のみ、選んだAIのキーを1つ設定する
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# 任意：モデルを変えたいとき（空なら各社の安いモデル）
AI_MODEL=

# 任意：「記憶する」で録音・ボイスメモを文字起こし＋要約する（Geminiのキー）
GEMINI_API_KEY=
AUDIO_MODEL=gemini-2.5-flash
# 任意：Geminiを使わず文字起こしだけする場合（OpenAIのキー）
# OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1
